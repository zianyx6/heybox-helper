{
  "manifest_version": 3,
  "name": "黑盒助手",
  "version": "0.11.1",
  "description": "小黑盒统一社区与消息界面、主题配色、双栏评论和连续页面预览",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.xiaoheihe.cn/*",
    "https://xiaoheihe.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaoheihe.cn/*",
        "https://xiaoheihe.cn/*"
      ],
      "js": [
        "reading.js",
        "social.js",
        "workspace.js",
        "rounded.js",
        "page-settings.js",
        "post-actions.js",
        "unified-layout.js",
        "motion.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaoheihe.cn/*",
        "https://xiaoheihe.cn/*"
      ],
      "js": [
        "following-main.js",
        "unified-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaoheihe.cn/*",
        "https://xiaoheihe.cn/*"
      ],
      "js": [
        "page-shell.js",
        "detail-init.js",
        "rounded.js",
        "motion.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.xiaoheihe.cn/*",
        "https://xiaoheihe.cn/*"
      ],
      "js": [
        "detail-layout.js",
        "game-layout.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.xiaoheihe.cn/*",
        "https://xiaoheihe.cn/*"
      ],
      "js": [
        "detail-main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
